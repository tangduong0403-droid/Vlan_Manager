# Sao chép tệp này thành .env và điền thông tin đăng nhập thực tế của lab
FLASK_SECRET_KEY=change_this_to_a_random_secret_key

# Thiết bị Cisco IOS 
<PREFIX_1>_USERNAME=your_username
<PREFIX_1>_PASSWORD=your_password
<PREFIX_1>_SECRET=your_enable_secret

# Thiết bị MikroTik RouterOS 
<PREFIX_2>_USERNAME=your_username
<PREFIX_2>_PASSWORD=your_password
